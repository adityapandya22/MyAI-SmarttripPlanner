# ── Server Configuration ───────────────────────────────────────────────────────
# Port for the local server (HTTP + WebSocket). Default: 5200
# PORT=5200

# Bind address. Default: 127.0.0.1 (localhost only). Docker overrides to 0.0.0.0
# AGENT_HOST=127.0.0.1

# Allowed origins for WebSocket and CSRF checks (comma-separated).
# Default includes localhost/127.0.0.1 on ports 5200 (server), 5199 (Vite dev), 5173, and 5300 (preview)
# ALLOWED_ORIGINS="http://localhost:5199,http://127.0.0.1:5199"

# ── Client-side Configuration (Vite) ──────────────────────────────────────────
# Vite dev server port. Default: 5199
# VITE_PORT=5199
# Map tile provider overrides (defaults to OpenStreetMap standard tiles with no watermark)
# Optional: Use Stadia Maps, MapTiler, or CARTO with your private key
# VITE_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# VITE_MAP_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"

# ── Server-side AI Provider Keys (Optional) ─────────────────────────────────
# The app works 100% free with the built-in Autonomous Free Agent (no key needed).
# If you wish to use cloud LLMs, add your API keys below:
# Google Gemini (Free tier from https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=""

# Groq (Free tier with LLaMA 3.3 70B from https://console.groq.com/keys)
# GROQ_API_KEY=""

# OpenAI-compatible API key (optional)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL=""
# OPENAI_MODEL=""

# ── Worldwide places & geocoding configuration (Optional) ────────────────────
# WORLD_PLACES_ENABLED=1
# NOMINATIM_EMAIL="traveler@example.com"

# ── Backward compatibility ───────────────────────────────────────────────────
# AGENT_PORT is the legacy name for PORT (still supported as fallback)
# AGENT_PORT=5200
# VITE_AGENT_PORT=5200
