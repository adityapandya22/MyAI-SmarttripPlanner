# ─── Map Tiles ───────────────────────────────────────────────────────────────
# Default: OpenStreetMap (free, no key required).
# Override with a Stadia/MapTiler/CARTO tiled URL if you have an API key.
# VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://stadiamaps.com/">Stadia Maps</a>

# ─── Optional: smarter AI ────────────────────────────────────────────────────
# The free built-in planner works with NO key. Set one of these for richer plans.
# GEMINI_API_KEY=your-free-google-gemini-key
# GROQ_API_KEY=your-free-groq-key
# OPENAI_API_KEY=your-openai-key
